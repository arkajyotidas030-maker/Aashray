# Copy to backend/.env — none of these are third-party production secrets in the demo.

# Local JWT signing (not an external API key). Use 32+ characters.
JWT_SECRET=change-me-before-demo-use-32-chars+
DATABASE_URL=sqlite:///./aashray.db
DEMO_MODE=1

# OPTIONAL LLM: OpenAI-compatible chat completions. Empty = RULE sitrep only.
LLM_API_KEY=
LLM_BASE_URL=

# Reserved. This prototype does not call OSRM; routes stay PRECOMPUTED.
OSRM_URL=

MEDIA_DIR=./media
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174
SEED_CITIZEN_EMAIL=citizen@demo
SEED_OPS_EMAIL=ops@demo
SEED_PASSWORD=demo
